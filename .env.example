# KPR Production Studio - Authentication & OTP API Configuration

# 1. Supabase Credentials (Cloud Auth, Database & Native SMS/Email OTP)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. EmailJS Credentials (Direct Email OTP Dispatching)
VITE_EMAILJS_SERVICE_ID=service_kpr_otp
VITE_EMAILJS_TEMPLATE_ID=template_otp_code
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# 3. Fast2SMS Credentials (Direct Cellular SMS to Indian Mobile Numbers +91)
VITE_FAST2SMS_API_KEY=your_fast2sms_api_key

# 4. Twilio Credentials (Global Cellular SMS OTP)
VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token
VITE_TWILIO_PHONE_NUMBER=+1234567890
